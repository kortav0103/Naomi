        <mxCell id="p1_title" value="&lt;b&gt;MÔ HÌNH THỰC THỂ KẾT HỢP QUAN NIỆM (CONCEPTUAL ER DIAGRAM) - NAOMI APP&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size: 12px;&quot;&gt;Chuẩn Peter Chen (Elmasri &amp;amp; Navathe - Chapter 2) • Đã hiệu chỉnh chuẩn xác Thực thể yếu &amp;amp; Quan hệ nhị phân&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="1100" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p1_legend" value="&lt;b&gt;QUY ƯỚC KÝ HIỆU CHEN CHUẨN XÁC:&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Hình chữ nhật đơn:&lt;/b&gt; Tập thực thể mạnh (Strong Entity)&lt;br&gt;• &lt;b&gt;Hình chữ nhật đôi:&lt;/b&gt; Tập thực thể yếu (Weak Entity - &lt;i&gt;Không có PK riêng&lt;/i&gt;)&lt;br&gt;• &lt;b&gt;Hình thoi đơn:&lt;/b&gt; Mối kết hợp thông thường (Binary Relationship)&lt;br&gt;• &lt;b&gt;Hình thoi đôi:&lt;/b&gt; Mối kết hợp xác định (Identifying Relationship)&lt;br&gt;• &lt;b&gt;Oval gạch chân liền:&lt;/b&gt; Khóa chính (PK) • &lt;b&gt;Oval gạch chân đứt:&lt;/b&gt; Khóa bộ phận (Partial Key)&lt;br&gt;• &lt;b&gt;Đường đôi:&lt;/b&gt; Ràng buộc tham gia toàn phần (Total Participation)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#334155;" vertex="1" parent="1">
